# ---------------------------------------------------------------------------
# Copiez ce fichier en .env :  cp .env.example .env
# .env est ignoré par git — ne le commitez jamais.
# ---------------------------------------------------------------------------

# Clé API Anthropic (console.anthropic.com). Requise uniquement pour le
# service « ai ». Le générateur heuristique de la page fonctionne sans.
ANTHROPIC_API_KEY=sk-ant-...

# Modèle utilisé pour la génération.
ANTHROPIC_MODEL=claude-opus-5

# Origine autorisée à appeler le service (CORS). Doit correspondre à l'URL
# depuis laquelle vous ouvrez l'interface.
ALLOWED_ORIGIN=http://localhost:8080

# Ports exposés sur la machine hôte.
WEB_PORT=8080
AI_PORT=8787
